{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RiftHelper",
  "version": "1.0.0",
  "identifier": "com.rifthelper.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RiftHelper",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "url": "https://rift-helper.com",
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "RiftHelper",
    "shortDescription": "RiftHelper desktop app",
    "longDescription": "RiftHelper: perfil y analisis de partidas de League of Legends."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Elensito/RiftHelper/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCMDNFMTM2QTUxQzQxM0QKUldROVFSeWxOdUVEdTdnYm8vZWhDR21LeFlDamljVUhNcEFrZnBBenVSZ3lSbUNpajd3emUxRCsK"
    }
  }
}
